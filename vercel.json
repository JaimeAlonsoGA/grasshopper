{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "make site",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
